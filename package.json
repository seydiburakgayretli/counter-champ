{
  "name": "counter-champ",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:poki": "tsc --noEmit && vite build --mode poki",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.cjs",
    "test:portal": "node tests/portal.cjs crazygames && node tests/portal.cjs poki"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
